{
  "style": "jaws",
  "about": "JAWS keys (laptop layout, Caps Lock as the JAWS key), 20 Oct 2026. Only keys that differ from NVDA's: everything else is the Windows style's. A value is a command's name, or '=' and another key whose command it runs. Mapping and gaps: reference/keyboard-styles/style-mapping.md (private) and docs/KEYBOARD-STYLES-PLAN.md.",
  "keys": {
    "kb:turnover+,": "jaws_sayCharacter",
    "kb:turnover+m": "=kb:turnover+leftArrow",
    "kb:turnover+.": "=kb:turnover+rightArrow",
    "kb:turnover+k": "=kb:turnover+control+.",
    "kb:turnover+j": "=kb:turnover+control+leftArrow",
    "kb:turnover+l": "=kb:turnover+control+rightArrow",
    "kb:turnover+i": "=kb:turnover+l",
    "kb:turnover+u": "=kb:turnover+upArrow",
    "kb:turnover+o": "=kb:turnover+downArrow",
    "kb:turnover+h": "reportCurrentSentence",
    "kb:turnover+y": "vo_previousSentence",
    "kb:turnover+n": "vo_nextSentence",
    "kb:turnover+control+i": "=kb:turnover+shift+p",
    "kb:turnover+control+u": "vo_previousParagraph",
    "kb:turnover+control+o": "vo_nextParagraph",
    "kb:turnover+shift+j": "jaws_sayLineToCursor",
    "kb:turnover+shift+l": "jaws_sayCursorToLineEnd",
    "kb:turnover+shift+a": "jaws_saySelection",
    "kb:turnover+shift+y": "=kb:turnover+t",
    "kb:turnover+shift+n": "=kb:turnover+shift+end",
    "kb:turnover+control+shift+j": "=kb:turnover+n",
    "kb:turnover+f4": "=kb:turnover+q",
    "kb:turnover+f2": "jaws_settings",
    "kb:turnover+6": "jaws_settings",
    "kb:turnover+v": "jaws_settings",
    "kb:turnover+3": "=kb:turnover+f2",
    "kb:turnover+escape": "=kb:turnover+f5",
    "kb:turnover+q": "=kb:turnover+control+f1",
    "kb:turnover+control+v": "jaws_appVersion",
    "kb:turnover+f10": "=kb:option+tab",
    "kb:turnover+f11": "=kb:option+b",
    "kb:turnover+control+f12": "jaws_timeWithSeconds",
    "kb:turnover+control+f1": "=kb:turnover+f1",
    "kb:turnover+control+h": "jaws_speechHistory",
    "kb:turnover+;": "=kb:turnover+backspace",
    "kb:turnover+'": "=kb:turnover+shift+backspace",
    "kb:turnover+leftArrow": "=kb:turnover+shift+leftArrow",
    "kb:turnover+rightArrow": "=kb:turnover+shift+rightArrow",
    "kb:turnover+p": "=kb:turnover+shift+n",
    "kb:turnover+[": "=kb:turnover+shift+m",
    "kb:turnover+8": "=kb:turnover+[",
    "kb:turnover+9": "=kb:turnover+]",
    "kb:turnover+shift+,": "=kb:turnover+control+shift+.",
    "kb:turnover+z": "=kb:turnover+space",
    "kb:turnover+f3": "=kb:turnover+f7",
    "kb:turnover+f5": "jaws_formFieldsList",
    "kb:turnover+f6": "jaws_headingsList",
    "kb:turnover+f7": "jaws_linksList",
    "kb:turnover+f9": "=kb:turnover+f7",
    "kb:turnover+control+f7": "=kb:turnover+k",
    "kb:turnover+\\": "vo_disclosure",
    "kb:turnover+shift+f1": "vo_describeOrWordAndCharacter",
    "kb:turnover+shift+pageUp": "=kb:turnover+control+command+rightArrow",
    "kb:turnover+shift+pageDown": "=kb:turnover+control+command+downArrow",
    "kb:turnover+option+shift+c": "vo_columnHeaderOrCharacter",
    "kb:turnover+option+shift+r": "vo_rowHeader",
    "kb:turnover+s": "=kb:turnover+5",
    "kb:turnover+option+v": "=kb:turnover+option+t",
    "kb:turnover+option+x": "=kb:turnover+c",
    "kb:turnover+f1": "vo_helpTag",
    "kb:turnover+control+shift+h": "=kb:turnover+/"
  },
  "duringSayAll": {
    "kb:leftArrow": "jaws_sayAllBack",
    "kb:rightArrow": "jaws_sayAllOn",
    "kb:pageUp": "jaws_sayAllFaster",
    "kb:pageDown": "jaws_sayAllSlower"
  }
}
