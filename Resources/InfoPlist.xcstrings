{
  "sourceLanguage" : "en",
  "strings" : {
    "NSAppleEventsUsageDescription" : {
      "comment" : "A reason macOS shows when it asks for a permission (Info.plist)",
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TurnOver, VoiceOver'dan okuduğu yerde birkaç sözcük söylemesini, Microsoft Word'den sayfa ve satır numarasını ve sunum oynatılırken Keynote'tan gösterilen slaytın sözcüklerini ister."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TurnOver просит VoiceOver произнести несколько слов там, где VoiceOver читает, запрашивает у Microsoft Word номер страницы и строки, а у Keynote — слова слайда, который показывается во время презентации."
          }
        }
      }
    },
    "NSAudioCaptureUsageDescription" : {
      "comment" : "A reason macOS shows when it asks for a permission (Info.plist)",
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TurnOver okurken VoiceOver'ın sesini kısık tutar, böylece ikisi asla aynı anda konuşmaz. Hiçbir şey kaydedilmez, saklanmaz ya da gönderilmez."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пока TurnOver читает, он приглушает звук VoiceOver, чтобы они никогда не говорили одновременно. Ничего не записывается, не сохраняется и не отправляется."
          }
        }
      }
    },
    "NSBluetoothAlwaysUsageDescription" : {
      "comment" : "A reason macOS shows when it asks for a permission (Info.plist)",
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TurnOver, VoiceOver gibi Bluetooth braille ekranınıza bağlanır."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TurnOver подключается к вашему Bluetooth-дисплею Брайля так же, как VoiceOver."
          }
        }
      }
    },
    "NSInputMonitoringUsageDescription" : {
      "comment" : "A reason macOS shows when it asks for a permission (Info.plist)",
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TurnOver, okuduğu uygulamalarda VoiceOver tuşlarını dinler; böylece sizin için okuyabilir ve gezinebilir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TurnOver перехватывает клавиши VoiceOver в приложениях, которые читает, чтобы читать и перемещаться за вас."
          }
        }
      }
    }
  },
  "version" : "1.0"
}