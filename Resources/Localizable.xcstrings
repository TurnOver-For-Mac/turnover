          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, TurnOver'ın temel tuşlarından biri ve değiştirilemez"
          }
        }
      }
    },
    "%@ is open, not the one chosen. Press Return again." : {
      "comment" : "Spoken message: %@ is the conversation open",
      "localizations" : {
