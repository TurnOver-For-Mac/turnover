          "stringUnit" : {
            "state" : "translated",
            "value" : "TurnOver beklenmedik biçimde durdu. Yeniden başlatılıyor."
          }
        }
      }
    },
    "TurnOver takes over" : {
      "comment" : "A welcome page's title",
      "extractionState" : "stale",
      "localizations" : {
