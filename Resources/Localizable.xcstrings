          }
        }
      }
    },
    "TurnOver has been updated to build %@, with 1 new thing to try: TurnOver menu, New in build %@." : {
      "comment" : "After an update: the build",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "TurnOver has been updated to build %1$@, with 1 new thing to try: TurnOver menu, New in build %2$@."
