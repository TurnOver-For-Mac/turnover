    },
    "TurnOver turned this window away: it was probably updated while the window was open. Quit Settings and open it again from the TurnOver menu." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TurnOver bu pencereyi kabul etmedi: büyük olasılıkla pencere açıkken güncellendi. Ayarlar'dan çıkın ve TurnOver menüsünden yeniden açın."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TurnOver отказался от этого окна: вероятно, оно обновилось, пока было открыто. Закройте Настройки и откройте их снова из меню TurnOver."
          }
        }
      }
    },
    "TurnOver will read %@ when it changes. Saved" : {
