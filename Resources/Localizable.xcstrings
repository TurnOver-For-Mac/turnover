      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TurnOver"
          }
        }
      }
    },
    "TurnOver %@, build %@, a screen reader for the Mac. It reads the apps you give it under Tools. Feature requests and bug reports through GitHub." : {
      "comment" : "About TurnOver",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "TurnOver %1$@, build %2$@, a screen reader for the Mac. It reads the apps you give it under Tools. Feature requests and bug reports through GitHub."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TurnOver %1$@, yapı %2$@, Mac için bir ekran okuyucu. Araçlar altında ona verdiğiniz uygulamaları okur. Özellik istekleri ve hata bildirimleri GitHub üzerinden."
          }
        }
      }
    },
    "TurnOver %@, build %@, a screen reader for the Mac. It reads the apps you give it under Tools; with CoExist on, VoiceOver reads the rest. Feature requests and bug reports through GitHub." : {
      "comment" : "About TurnOver",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "TurnOver %1$@, build %2$@, a screen reader for the Mac. It reads the apps you give it under Tools; with CoExist on, VoiceOver reads the rest. Feature requests and bug reports through GitHub."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TurnOver %1$@, yapı %2$@, Mac için bir ekran okuyucu. Araçlar altında ona verdiğiniz uygulamaları okur; CoExist açıkken gerisini VoiceOver okur. Özellik istekleri ve hata bildirimleri GitHub üzerinden."
          }
        }
      }
    },
    "TurnOver Down reads from here; TurnOver H moves by heading." : {
      "comment" : "A hint, said after a pause on an item",
      "localizations" : {
