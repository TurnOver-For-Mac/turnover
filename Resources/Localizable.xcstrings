        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pencere seçici (sayısal tuş takımında Eğik Çizgi, VoiceOver'daki gibi)"
          }
        }
      }
    },
    "The window is looked at each second; when it has changed, what is new is read." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Окно проверяется каждую секунду; когда оно изменилось, новое читается."
          }
        }
      }
    },
    "The window's size and where it is on the screen (VO-Command-F2)" : {
      "comment" : "A command, as the key list and keyboard help say it",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
