{
  "sourceLanguage" : "en",
  "strings" : {
    " and " : {
      "comment" : "Between names in a list, with its spaces",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " ve "
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " и "
          }
        }
      }
    },
    "%@\n\nVoiceOver is still on. Check for an update from the TurnOver menu next time, or send feedback." : {
      "comment" : "An alert: %@ is the error",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nVoiceOver hâlâ açık. Bir dahaki sefere TurnOver menüsünden güncellemeleri denetleyin ya da geri bildirim gönderin."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nVoiceOver всё ещё включён. В следующий раз проверьте обновление в меню TurnOver или отправьте отзыв."
          }
        }
      }
    },
    "%@ %@" : {
      "comment" : "A battery's time: the hours, then the minutes",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %@"
          }
        }
      }
    },
    "%@ %@, for %@" : {
      "comment" : "A plugin: its name, version and apps",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@, for %3$@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@, %3$@ için"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %@, для %@"
          }
        }
      }
    },
    "%@ %@. The harbour opens at nine." : {
      "comment" : "The EQ changed: %1$@ is bass, middle or treble, %2$@ the decibels",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@. The harbour opens at nine."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@. Liman dokuzda açılır."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %@. Гавань открывается в девять."
          }
        }
      }
    },
    "%@ Report the problem at github.com/TurnOver-For-Mac/turnover/issues." : {
      "comment" : "Feedback: %@ says where the report is",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Sorunu github.com/TurnOver-For-Mac/turnover/issues adresinden bildirin."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Сообщите о проблеме на github.com/TurnOver-For-Mac/turnover/issues."
          }
        }
      }
    },
    "%@ TurnOver's problem form is open in your browser: say what happened, and drag the report in if you like." : {
      "comment" : "Feedback: %@ says where the report is",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ TurnOver'ın sorun formu tarayıcınızda açık: ne olduğunu yazın, isterseniz raporu sürükleyip bırakın."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Форма обращения TurnOver открыта в браузере: опишите, что произошло, и при желании перетащите туда отчёт."
          }
        }
      }
    },
    "%@ already does: %@. Not given; choose another key" : {
      "comment" : "A key already taken: %1$@ is the key, %2$@ its command",
