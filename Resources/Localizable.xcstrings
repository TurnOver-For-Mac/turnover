          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TurnOver henüz %1$@ uygulamasını okumuyor. %2$@ için bundan sonra TurnOver ile okunsun mu?"
          }
        }
      }
    },
    "TurnOver doesn't read %@ yet. Read them with TurnOver from now on, for %@?" : {
      "comment" : "A plugin's apps TurnOver doesn't read: the apps, then the plugins",
      "localizations" : {
        "en" : {
