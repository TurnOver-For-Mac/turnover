    },
    "TurnOver quitting" : {
      "comment" : "TurnOver is about to quit",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TurnOver kapanıyor"
          }
        }
      }
    },
    "TurnOver reads %@ from now on. Switch to it and back once." : {
