    "%@ Report the problem at github.com/TurnOver-For-Mac/turnover/issues." : {
      "comment" : "Feedback: %@ says where the report is",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Sorunu github.com/TurnOver-For-Mac/turnover/issues adresinden bildirin."
          }
        }
      }
    },
    "%@ TurnOver's problem form is open in your browser: say what happened, and drag the report in if you like." : {
      "comment" : "Feedback: %@ says where the report is",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
