          }
        }
      }
    },
    "Opens TurnOver's %@ (NVDA+Control+%@: %@ settings)" : {
      "comment" : "A command: %1$@ is a section of TurnOver's Settings, %2$@ a letter, %3$@ NVDA's own name for the dialog",
