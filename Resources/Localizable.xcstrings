        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открывает публичный запрос на GitHub, заполненный тем, как приложение устроено, но никогда — тем, что в нём есть. Нужен аккаунт GitHub"
          }
