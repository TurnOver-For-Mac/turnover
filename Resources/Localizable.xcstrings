          }
        }
      }
    },
    "TurnOver's releases page is open in your browser" : {
      "comment" : "Spoken message",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TurnOver'ın sürümler sayfası tarayıcınızda açık"
