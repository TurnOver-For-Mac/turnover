          }
        }
      }
    },
    "Makes Steam open a debugging port on this Mac while it runs, which other programs here could use too. Off removes it" : {
      "extractionState" : "stale",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заставляет Steam открывать на этом Mac отладочный порт, пока он работает, — им могут воспользоваться и другие программы. При выключении порт закрывается"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
