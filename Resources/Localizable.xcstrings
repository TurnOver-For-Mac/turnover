            "state" : "translated",
            "value" : "Команды TurnOver"
          }
        }
      }
    },
    "TurnOver commands, %@." : {
      "comment" : "The TurnOver layer as a list: how many",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TurnOver komutları, %@."
          }
        },
        "ru" : {
