          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öğeyi fareyle tıklar; iki kez basılınca çift tıklar (VO-Shift-Boşluk, VO-Shift-Boşluk-Boşluk)"
          }
        }
      }
    },
    "Clicks the left mouse button where the pointer is (NVDA+Left Bracket)" : {
