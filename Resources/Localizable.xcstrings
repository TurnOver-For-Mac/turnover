    "Withdrawn from the plugin library and switched off: %@." : {
      "comment" : "Plugins withdrawn: %@ lists them",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Убран из библиотеки плагинов и выключен: %@."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eklenti kitaplığından çekildi ve kapatıldı: %@."
          }
        }
      }
    },
    "Words" : {
      "localizations" : {
