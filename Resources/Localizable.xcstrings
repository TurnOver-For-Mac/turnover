        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TurnOver siz yazdıkça karakterleri sayar; Tab ilerler"
          }
        }
      }
    },
    "TurnOver doesn't read %@ yet. Read it with TurnOver from now on, for %@?" : {
      "comment" : "A plugin's app TurnOver doesn't read: the app, then the plugin",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
