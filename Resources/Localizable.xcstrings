        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TurnOver'ın kendi pencereleri değiştirilemez"
          }
        }
      }
    },
    "TurnOver's releases page is open in your browser" : {
      "comment" : "Spoken message",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Страница выпусков TurnOver открыта в браузере"
