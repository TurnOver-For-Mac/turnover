{
  "sourceLanguage" : "en",
  "strings" : {
    " and " : {
      "comment" : "Between names in a list, with its spaces",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " ve "
          }
        }
      }
    },
    "%@\n\nVoiceOver is still on. Check for an update from the TurnOver menu next time, or send feedback." : {
      "comment" : "An alert: %@ is the error",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nVoiceOver hâlâ açık. Bir dahaki sefere TurnOver menüsünden güncellemeleri denetleyin ya da geri bildirim gönderin."
          }
        }
      }
    },
    "%@ %@" : {
      "comment" : "A battery's time: the hours, then the minutes",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@"
          }
        }
      }
    },
    "%@ %@, for %@" : {
      "comment" : "A plugin: its name, version and apps",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@, for %3$@"
