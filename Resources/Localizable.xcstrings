    "TurnOver could not start" : {
      "comment" : "An alert's title",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TurnOver başlatılamadı"
          }
        },
        "ru" : {
