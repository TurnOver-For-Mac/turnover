      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TurnOver kılavuzu"
          }
        }
      }
    },
    "TurnOver has been updated to build %@, with %@ new things to try: TurnOver menu, New in build %@." : {
      "comment" : "After an update: the build and how many new things",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "TurnOver has been updated to build %1$@, with %2$@ new things to try: TurnOver menu, New in build %3$@."
          }
