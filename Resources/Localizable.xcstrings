          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, yapan %2$@: %3$@"
          }
        }
      }
    },
    "%@ can make TurnOver say anything while it is the app in front, and nothing else" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
