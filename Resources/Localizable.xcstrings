    },
    "%@ is built with %@. TurnOver has the parts for it, so anyone can make its plugin" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is built with %2$@. TurnOver has the parts for it, so anyone can make its plugin"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ построен на %@. У TurnOver есть нужные части, так что плагин может сделать любой"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@ ile yapılmış. TurnOver'da bunun için gereken parçalar var, bu yüzden herkes eklentisini yapabilir"
          }
        }
      }
