    "Opening %@" : {
      "comment" : "Spoken message",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открываю %@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ açılıyor"
          }
        }
      }
    },
    "Opening %@ in Terminal, in the brief's folder. It will ask what is wrong in %@; it can check, try and install the plugin itself." : {
      "comment" : "Making a plugin with an AI tool: the tool, then the app",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Opening %1$@ in Terminal, in the brief's folder. It will ask what is wrong in %2$@; it can check, try and install the plugin itself."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открываю %@ в Терминале, в папке с заданием. Он спросит, что не так в %@; он может проверить, попробовать и сам установить плагин."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Terminal'de, özet klasöründe açılıyor. %2$@ uygulamasında neyin yanlış olduğunu soracak; eklentiyi kendisi denetleyebilir, deneyebilir ve kurabilir."
          }
        }
      }
    },
    "Opening Claude Code in the brief's folder. The request is typed in: finish the sentence with what is wrong in %@, and send. Claude can check and install the plugin itself." : {
      "comment" : "Making a plugin with Claude Code: %@ is the app",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открываю Claude Code в папке с заданием. Запрос уже набран: допишите, что не так в %@, и отправьте. Claude может проверить и сам установить плагин."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code özet klasöründe açılıyor. İstek yazıldı: cümleyi %@ uygulamasında neyin yanlış olduğuyla tamamlayın ve gönderin. Claude eklentiyi kendisi denetleyip kurabilir."
          }
        }
      }
    },
    "Opens %@" : {
      "comment" : "Your own key: %@ is the app it opens",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открывает %@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ uygulamasını açar"
          }
        }
      }
    },
    "Opens Notification Centre and goes to its first notification; again closes it (VO-O)" : {
      "comment" : "A command, as the key list and keyboard help say it",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открывает Центр уведомлений и переходит к первому уведомлению; повторно — закрывает его (VO-O)"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildirim Merkezi'ni açar ve ilk bildirimine gider; yeniden basılınca kapatır (VO-O)"
          }
        }
      }
    },
    "Opens TurnOver's %@ (NVDA+Control+%@: %@ settings)" : {
      "comment" : "A command: %1$@ is a section of TurnOver's Settings, %2$@ a letter, %3$@ NVDA's own name for the dialog",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Opens TurnOver's %1$@ (NVDA+Control+%2$@: %3$@ settings)"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открывает %@ в TurnOver (NVDA+Control+%@: настройки %@)"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TurnOver'ın %1$@ bölümünü açar (NVDA+Kontrol+%2$@: %3$@ ayarları)"
          }
        }
      }
    },
    "Opens TurnOver's settings in its menu (JAWS: Insert+F2, Insert+6)" : {
      "comment" : "A command, as the key list and keyboard help say it",
      "localizations" : {
