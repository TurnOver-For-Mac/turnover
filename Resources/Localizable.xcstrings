    "Open the log; writes the navigator object's details to the log and opens the log (NVDA+F1)" : {
      "comment" : "A command, as the key list and keyboard help say it",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaydı aç; gezgin nesnesinin ayrıntılarını kayda yazar ve kaydı açar (NVDA+F1)"
          }
        },
        "ru" : {
          "stringUnit" : {
