    "%@ doesn't speak in TurnOver, so TurnOver is back to %@. Choose another in the TurnOver menu, Settings, Speech." : {
      "comment" : "A silent voice replaced: the voice, then the one used instead",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ doesn't speak in TurnOver, so TurnOver is back to %2$@. Choose another in the TurnOver menu, Settings, Speech."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ TurnOver'da konuşmuyor, bu yüzden TurnOver %2$@ sesine döndü. TurnOver menüsü, Ayarlar, Konuşma'dan başka bir ses seçin."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ не говорит в TurnOver, поэтому TurnOver снова использует %@. Выберите другой голос в меню TurnOver, Настройки, Речь."
          }
        }
      }
    },
