    },
    "This plugin can act on %@: %@. To install it anyway, choose the same Install again within 20 seconds." : {
      "comment" : "A plugin's warnings: the app, then the warnings (in English)",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This plugin can act on %1$@: %2$@. To install it anyway, choose the same Install again within 20 seconds."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu eklenti %1$@ üzerinde işlem yapabilir: %2$@. Yine de kurmak için 20 saniye içinde aynı Kur'u yeniden seçin."
          }
        },
        "ru" : {
          "stringUnit" : {
