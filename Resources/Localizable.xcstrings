    },
    "%@ headings" : {
      "comment" : "A count on a page",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заголовков: %@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ başlık"
          }
        }
      }
    },
    "%@ helps you make the fix for %@, one step at a time, and checks with you before anything is sent. You need Xcode, Apple's free tool for building apps, and a free GitHub account; %@ helps you set them up. For three hours it may also try keys in %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ helps you make the fix for %2$@, one step at a time, and checks with you before anything is sent. You need Xcode, Apple's free tool for building apps, and a free GitHub account; %3$@ helps you set them up. For three hours it may also try keys in %4$@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ помогает сделать исправление для %2$@ шаг за шагом и спрашивает вас, прежде чем что-то отправить. Нужны Xcode — бесплатный инструмент Apple для сборки приложений — и бесплатный аккаунт GitHub; %3$@ помогает их настроить. В течение трёх часов он также может пробовать клавиши в %4$@"
          }
        }
      }
    },
    "%@ images" : {
      "comment" : "A count on a page",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изображений: %@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ resim"
          }
        }
      }
    },
    "%@ installed" : {
      "comment" : "An app finished installing",
      "localizations" : {
